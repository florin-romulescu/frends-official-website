---
import { getLangFromUrl, useTranslations, localizePath, localizeHref, isExternal } from '../../i18n';
import { getSite } from '../../data/site';
import { getSiteImage } from '../../data/images';
import Section from '../../layouts/primitives/Section.astro';
import Split from '../../layouts/primitives/Split.astro';
import Stack from '../../layouts/primitives/Stack.astro';
import Cluster from '../../layouts/primitives/Cluster.astro';
import Button from '../Button';
import PhotoCard from '../PhotoCard';
import PhotoCardSlot from '../PhotoCardSlot';
import Pill from '../Pill';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const site = await getSite();
const [photo, helpIcon] = await Promise.all([getSiteImage('hero_photo'), getSiteImage('icon_help')]);
---
<Section id="acasa" space="md">
  <Split at="xl" gap="xl">
    <Stack gap="lg">
      <h1 class="font-display text-display font-extrabold text-brand">{t('hero.heading')}</h1>
      <p class="max-w-[430px] text-body-lg font-black">{t('hero.lede')}</p>
      <Cluster gap="md">
        <Button href={localizeHref(site.volunteerUrl, lang)} external={isExternal(site.volunteerUrl)} size="lg">
          {t('nav.volunteer')}
        </Button>
        <Button href={localizePath('/proiecte', lang)} variant="secondary" size="lg">
          {t('nav.projects')}
        </Button>
      </Cluster>
    </Stack>

    <PhotoCard image={photo} imageAlt={photo.alt} shape="landscape" priority>
      <PhotoCardSlot corner="top-left">
        <Pill variant="caption">{t('hero.photoCaption')}</Pill>
      </PhotoCardSlot>

      <PhotoCardSlot corner="bottom-right">
        <p
          class="flex max-w-[280px] items-center gap-2.5 rounded-card bg-surface p-4 text-body-lg font-black shadow-card xl:p-6"
        >
          <img src={helpIcon.src} alt="" width={36} height={36} class="size-9 shrink-0" />
          <span>{t('hero.statCard')}</span>
        </p>
      </PhotoCardSlot>
    </PhotoCard>
  </Split>
</Section>
