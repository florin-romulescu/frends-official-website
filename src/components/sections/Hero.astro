---
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n';
import { site } from '../../data/site';
import heroPhoto from '../../assets/img/hero-group.jpg';
import Button from '../Button';
import Pill from '../Pill';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="container-content pt-12 pb-16 lg:pt-20 lg:pb-24">
  <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
    <div>
      <h1 class="font-display text-display font-extrabold text-brand">{t('hero.heading')}</h1>
      <p class="mt-6 max-w-[430px] text-body-lg font-black">{t('hero.lede')}</p>

      <div class="mt-8 flex flex-wrap gap-4">
        <Button href={localizePath(site.volunteerUrl, lang)} size="lg">
          {t('nav.volunteer')}
        </Button>
        <Button href={localizePath('/proiecte', lang)} variant="secondary" size="lg">
          {t('nav.projects')}
        </Button>
      </div>
    </div>

    {/*
      The photo carries two floating overlays in the design. They are positioned
      against the figure rather than the page so they travel with the image at
      every breakpoint instead of needing per-width offsets.
    */}
    <figure class="relative">
      <Image
        src={heroPhoto}
        alt={t('hero.photoAlt')}
        widths={[480, 768, 1024, 1400]}
        sizes="(width >= 64rem) 50vw, 100vw"
        class="aspect-[699/460] w-full rounded-panel object-cover"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>
        <Pill variant="caption" className="absolute top-4 left-4 lg:top-6 lg:left-6">
          {t('hero.photoCaption')}
        </Pill>
      </figcaption>

      <p
        class="absolute -bottom-6 right-2 flex max-w-[300px] items-center gap-2.5 rounded-card bg-surface p-4 text-body-lg font-black shadow-card lg:-right-6 lg:p-8"
      >
        <img src="/icons/help.png" alt="" width={36} height={36} class="size-9 shrink-0" />
        <span>{t('hero.statCard')}</span>
      </p>
    </figure>
  </div>
</section>
