---
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n';
import { site } from '../../data/site';
import heroPhoto from '../../assets/img/hero-group.jpg';
import Section from '../../layouts/primitives/Section.astro';
import Split from '../../layouts/primitives/Split.astro';
import Stack from '../../layouts/primitives/Stack.astro';
import Cluster from '../../layouts/primitives/Cluster.astro';
import Button from '../Button';
import Pill from '../Pill';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Section id="acasa" space="md">
  <Split at="xl" gap="xl">
    <Stack gap="lg">
      <h1 class="font-display text-display font-extrabold text-brand">{t('hero.heading')}</h1>
      <p class="max-w-[430px] text-body-lg font-black">{t('hero.lede')}</p>
      <Cluster gap="md">
        <Button href={localizePath(site.volunteerUrl, lang)} size="lg">
          {t('nav.volunteer')}
        </Button>
        <Button href={localizePath('/proiecte', lang)} variant="secondary" size="lg">
          {t('nav.projects')}
        </Button>
      </Cluster>
    </Stack>

    {/*
      The stat card overlaps the photo's lower-right corner in the design. Below
      `xl` there is no room to hang it outside the image, so it tucks inside the
      frame instead of pushing the section wider — an overlap that causes a
      horizontal scrollbar on a phone is worse than one that doesn't.
    */}
    <figure class="relative">
      <Image
        src={heroPhoto}
        alt={t('hero.photoAlt')}
        widths={[480, 768, 1024, 1400]}
        sizes="(width >= 80rem) 50vw, 100vw"
        class="aspect-[699/460] w-full rounded-panel object-cover"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>
        <Pill variant="caption" className="absolute top-4 left-4 lg:top-6 lg:left-6">
          {t('hero.photoCaption')}
        </Pill>
      </figcaption>

      <p
        class="absolute right-4 bottom-4 flex max-w-[280px] items-center gap-2.5 rounded-card bg-surface p-4 text-body-lg font-black shadow-card xl:-right-6 xl:-bottom-6 xl:p-6"
      >
        <img src="/icons/help.png" alt="" width={36} height={36} class="size-9 shrink-0" />
        <span>{t('hero.statCard')}</span>
      </p>
    </figure>
  </Split>
</Section>
