---
import { getLangFromUrl, useTranslations } from '../../i18n';
import { getSiteImage } from '../../data/images';
import Section from '../../layouts/primitives/Section.astro';
import Stack from '../../layouts/primitives/Stack.astro';
import Grid from '../../layouts/primitives/Grid.astro';
import PhotoCard from '../PhotoCard';
import PhotoCardSlot from '../PhotoCardSlot';
import Pill from '../Pill';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const projects = [
  {
    slot: 'impact_greenup',
    stats: ['4,000+ puieți plantați', 'Green Up'],
  },
  {
    slot: 'impact_poster',
    stats: ['200+ artiști expuși', 'Fii Artă'],
    caption: 'Eveniment cultural',
  },
  {
    slot: 'impact_event',
    stats: ['500+ participanți', 'Fii Voluntar'],
    caption:
      'Târg de ONG-uri și activități interactive pentru promovarea voluntariatului în rândul publicului larg.',
  },
] as const;

const cards = await Promise.all(
  projects.map(async (project) => ({ ...project, image: await getSiteImage(project.slot) })),
);
---
<Section id="impact" space="lg">
  <Stack gap="xl">
    <Stack gap="md" align="center" class="text-center">
      <Pill variant="title">{t('impact.title')}</Pill>
      <p class="max-w-[434px] text-body font-bold text-ink-muted">{t('impact.lede')}</p>
    </Stack>

    <Grid as="ul" min="20rem" gap="lg">
      {
        cards.map((project) => (
          <li>
            <PhotoCard image={project.image} imageAlt={project.image.alt}>
              <PhotoCardSlot corner="top-left">
                {project.stats.map((stat) => (
                  <Pill variant="stat">{stat}</Pill>
                ))}
              </PhotoCardSlot>
              {'caption' in project && (
                <PhotoCardSlot corner="bottom-left">
                  <Pill variant="note" className="text-left">
                    {project.caption}
                  </Pill>
                </PhotoCardSlot>
              )}
            </PhotoCard>
          </li>
        ))
      }
    </Grid>
  </Stack>
</Section>
