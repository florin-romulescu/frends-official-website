---
import { getImage } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '../../i18n';
import greenup from '../../assets/img/impact-greenup.jpg';
import poster from '../../assets/img/impact-poster.jpg';
import event from '../../assets/img/impact-event.jpg';
import ImpactCard from '../ImpactCard';
import Pill from '../Pill';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

/*
 * TODO (Phase 3): this moves to the CMS alongside `events`. The stat strings
 * stay literal rather than going through i18n because they are content, not UI
 * chrome — a second locale would translate them per entry, not per key.
 */
const projects = [
  {
    image: greenup,
    imageAlt: 'Voluntar FRENDS plantând un puiet într-o pădure',
    stats: ['4,000+ puieți plantați', 'Green Up'],
  },
  {
    image: poster,
    imageAlt: 'Vizitatori la standurile evenimentului Fii Artă',
    stats: ['200+ artiști expuși', 'Fii Artă'],
    caption: 'Eveniment cultural',
  },
  {
    image: event,
    imageAlt: 'Voluntari FRENDS la târgul de ONG-uri',
    stats: ['500+ participanți', 'Fii Voluntar'],
    caption:
      'Târg de ONG-uri și activități interactive pentru promovarea voluntariatului în rândul publicului larg.',
  },
];

const cards = await Promise.all(
  projects.map(async (project) => {
    const optimized = await getImage({
      src: project.image,
      widths: [409, 818],
      sizes: '(width >= 64rem) 26rem, (width >= 40rem) 45vw, 90vw',
    });
    return {
      ...project,
      resolved: {
        src: optimized.src,
        srcSet: optimized.srcSet.attribute || undefined,
        width: optimized.attributes.width,
        height: optimized.attributes.height,
      },
    };
  }),
);
---

<section class="container-content py-16 lg:py-24">
  <div class="flex flex-col items-center text-center">
    <Pill variant="title">{t('impact.title')}</Pill>
    <p class="mt-6 max-w-[434px] text-body font-bold text-ink-muted">{t('impact.lede')}</p>
  </div>

  <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      cards.map((project) => (
        <li>
          <ImpactCard
            image={project.resolved}
            imageAlt={project.imageAlt}
            stats={project.stats}
            caption={project.caption}
          />
        </li>
      ))
    }
  </ul>
</section>
