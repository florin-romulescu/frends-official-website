---
import { getImage } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '../../i18n';
import greenup from '../../assets/img/impact-greenup.jpg';
import poster from '../../assets/img/impact-poster.jpg';
import event from '../../assets/img/impact-event.jpg';
import Section from '../../layouts/primitives/Section.astro';
import Stack from '../../layouts/primitives/Stack.astro';
import Grid from '../../layouts/primitives/Grid.astro';
import PhotoCard from '../PhotoCard';
import PhotoCardSlot from '../PhotoCardSlot';
import Pill from '../Pill';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const projects = [
  {
    image: greenup,
    imageAlt: 'Voluntar FRENDS plantând un puiet într-o pădure',
    stats: ['4,000+ puieți plantați', 'Green Up'],
  },
  {
    image: poster,
    imageAlt: 'Vizitatori la standurile evenimentului Fii Artă',
    stats: ['200+ artiști expuși', 'Fii Artă'],
    caption: 'Eveniment cultural',
  },
  {
    image: event,
    imageAlt: 'Voluntari FRENDS la târgul de ONG-uri',
    stats: ['500+ participanți', 'Fii Voluntar'],
    caption:
      'Târg de ONG-uri și activități interactive pentru promovarea voluntariatului în rândul publicului larg.',
  },
];

const cards = await Promise.all(
  projects.map(async (project) => {
    const optimized = await getImage({
      src: project.image,
      widths: [409, 818],
      sizes: '(width >= 80rem) 26rem, (width >= 40rem) 45vw, 90vw',
    });
    return {
      ...project,
      resolved: {
        src: optimized.src,
        srcSet: optimized.srcSet.attribute || undefined,
        width: optimized.attributes.width,
        height: optimized.attributes.height,
      },
    };
  }),
);
---
<Section id="impact" space="lg">
  <Stack gap="xl">
    <Stack gap="md" align="center" class="text-center">
      <Pill variant="title">{t('impact.title')}</Pill>
      <p class="max-w-[434px] text-body font-bold text-ink-muted">{t('impact.lede')}</p>
    </Stack>

    <Grid as="ul" min="20rem" gap="lg">
      {
        cards.map((project) => (
          <li>
            <PhotoCard image={project.resolved} imageAlt={project.imageAlt}>
              <PhotoCardSlot corner="top-left">
                {project.stats.map((stat) => (
                  <Pill variant="stat">{stat}</Pill>
                ))}
              </PhotoCardSlot>
              {project.caption && (
                <PhotoCardSlot corner="bottom-left">
                  <Pill variant="note" className="text-left">
                    {project.caption}
                  </Pill>
                </PhotoCardSlot>
              )}
            </PhotoCard>
          </li>
        ))
      }
    </Grid>
  </Stack>
</Section>
