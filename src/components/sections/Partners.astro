---
import { getLangFromUrl, useTranslations } from '../../i18n';
import Section from '../../layouts/primitives/Section.astro';
import Stack from '../../layouts/primitives/Stack.astro';
import Grid from '../../layouts/primitives/Grid.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const placeholderCount = 4;
---
<Section id="parteneri" space="lg">
  <Stack gap="xl">
    <h2 class="text-h2">{t('partners.title')}</h2>

    <Grid as="ul" min="8rem" gap="md" class="max-w-[42rem]">
      {
        Array.from({ length: placeholderCount }, (_, i) => (
          <li class="grid aspect-square place-items-center rounded-[13px] bg-surface-placeholder p-3 text-center text-caption text-ink-muted">
            {t('partners.placeholder')} {i + 1}
          </li>
        ))
      }
    </Grid>
  </Stack>
</Section>
