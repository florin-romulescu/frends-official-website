---
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '../../i18n';
import aboutPhoto from '../../assets/img/about-group.jpg';
import Section from '../../layouts/primitives/Section.astro';
import Split from '../../layouts/primitives/Split.astro';
import Stack from '../../layouts/primitives/Stack.astro';
import Cluster from '../../layouts/primitives/Cluster.astro';
import Pill from '../Pill';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const tags = [t('about.tag1'), t('about.tag2'), t('about.tag3')];
---

<Section space="lg">
  {/* `reverse` puts the photo first above xl; stacked, the heading still leads. */}
  <Split at="xl" gap="xl" reverse>
    <Stack gap="lg">
      <h2 class="font-display text-display font-extrabold text-brand">{t('about.heading')}</h2>
      {/*
        Capped in ch, not px: at 768 this paragraph ran the full width of the
        viewport at ~110 characters a line, well past a comfortable measure.
      */}
      <p class="max-w-[62ch] text-body-lg">{t('about.body')}</p>
      <p class="text-body-lg font-black">{t('about.moreLead')}</p>
      <Cluster as="ul" gap="sm">
        {tags.map((tag) => <li><Pill variant="gray">{tag}</Pill></li>)}
      </Cluster>
    </Stack>

    <figure class="relative">
      <Image
        src={aboutPhoto}
        alt={t('about.photoAlt')}
        widths={[480, 768, 1024, 1400]}
        sizes="(width >= 80rem) 50vw, 100vw"
        class="aspect-[699/560] w-full rounded-panel object-cover"
        loading="lazy"
      />
      <figcaption>
        <Pill variant="caption" className="absolute bottom-4 left-4 lg:bottom-6 lg:left-6">
          {t('about.photoCaption')}
        </Pill>
      </figcaption>
    </figure>
  </Split>
</Section>
