---
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '../../i18n';
import goalsBg from '../../assets/img/goals-bg.jpg';
import Section from '../../layouts/primitives/Section.astro';
import Stack from '../../layouts/primitives/Stack.astro';
import Grid from '../../layouts/primitives/Grid.astro';
import GoalCard from '../GoalCard';
import Pill from '../Pill';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const goals = [
  t('goals.1'),
  t('goals.2'),
  t('goals.3'),
  t('goals.4'),
  t('goals.5'),
  t('goals.6'),
];
---

<Section space="sm" band="sky" width="wide">
  <Image
    slot="background"
    src={goalsBg}
    alt=""
    widths={[768, 1280, 1660]}
    sizes="100vw"
    class="absolute inset-0 size-full object-cover opacity-20"
    loading="lazy"
  />

  <Stack gap="xl" align="center">
    <Pill variant="title">{t('goals.title')}</Pill>

    {/*
      The design floats the six goals either side of the logo mark. That reads
      as a composition only when each column is wide enough for a title to fit
      on one or two lines, so it is an `xl` arrangement: two columns with a gap
      wide enough for the logo, which is centred over it.

      Below `xl` this stays ONE auto-fit list. Splitting it into two lists of
      three — the obvious way to get the desktop composition — left an orphan
      card on its own row at every width where the grid resolved to two columns.
    */}
    <div class="relative w-full">
      <Grid as="ul" min="16rem" gap="md" class="xl:grid-flow-col xl:grid-cols-2 xl:grid-rows-3 xl:gap-x-[19rem] xl:gap-y-14">
        {goals.map((goal, i) => <GoalCard index={i + 1} label={goal} />)}
      </Grid>

      <img
        src="/icons/logo-mark.svg"
        alt=""
        width={220}
        height={120}
        class="absolute top-1/2 left-1/2 hidden h-28 w-auto -translate-x-1/2 -translate-y-1/2 xl:block"
      />
    </div>
  </Stack>
</Section>
