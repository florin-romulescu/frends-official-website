---
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '../../i18n';
import goalsBg from '../../assets/img/goals-bg.jpg';
import Section from '../../layouts/primitives/Section.astro';
import GoalCard from '../GoalCard';
import Pill from '../Pill';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const goals = [
  t('goals.1'),
  t('goals.2'),
  t('goals.3'),
  t('goals.4'),
  t('goals.5'),
  t('goals.6'),
];
---
<Section id="obiective" space="sm" band="sky" width="wide">
  <Image
    slot="background"
    src={goalsBg}
    alt=""
    widths={[768, 1280, 1660]}
    sizes="100vw"
    class="absolute inset-0 size-full object-cover opacity-20"
    loading="lazy"
  />

  <div class="grid items-start justify-items-center gap-5 xl:grid-cols-2 xl:gap-y-10">
    <Pill variant="title" className="xl:col-start-1 xl:row-start-1 xl:justify-self-start">
      {t('goals.title')}
    </Pill>

    <ol class="flex w-full flex-col gap-2.5 xl:col-span-2 xl:row-start-2 xl:-mb-14 xl:flex-row xl:items-end xl:gap-0">
      {
        goals.map((goal, i) => (
          <li
            style={`--step:${i}`}
            class="ps-[calc(var(--step)*4.5%)] xl:flex xl:flex-1 xl:flex-col xl:justify-end xl:gap-5 xl:ps-0"
          >
            <GoalCard index={i + 1} label={goal} className="xl:mx-[17px] xl:w-auto" />
            <div class="hidden h-[calc(5.25rem+var(--step)*3.25rem)] rounded-t-xl bg-surface/40 xl:block" />
          </li>
        ))
      }
    </ol>

    <img
      src="/icons/logo-mark.svg"
      alt=""
      width={220}
      height={120}
      class="h-12 w-auto xl:col-start-2 xl:row-start-1 xl:h-[6.625rem] xl:justify-self-end"
    />
  </div>
</Section>
