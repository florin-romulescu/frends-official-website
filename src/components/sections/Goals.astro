---
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '../../i18n';
import goalsBg from '../../assets/img/goals-bg.jpg';
import GoalCard from '../GoalCard';
import Pill from '../Pill';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const goals = [
  t('goals.1'),
  t('goals.2'),
  t('goals.3'),
  t('goals.4'),
  t('goals.5'),
  t('goals.6'),
];
---

<section class="container-wide py-8">
  <div class="relative overflow-hidden rounded-panel bg-brand-light">
    <Image
      src={goalsBg}
      alt=""
      widths={[768, 1280, 1660]}
      sizes="100vw"
      class="absolute inset-0 size-full object-cover opacity-20"
      loading="lazy"
    />

    <div class="relative px-4 py-12 lg:px-10 lg:py-14">
      <div class="flex justify-center">
        <Pill variant="title">{t('goals.title')}</Pill>
      </div>

      {/*
        The design floats the six cards around a central logo on desktop. That
        arrangement only reads as a composition when there is room for it, so
        below `lg` the same list becomes a plain single column and the logo is
        dropped rather than shrunk into the middle of the text.
      */}
      <div class="mt-10 grid gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-[1fr_auto_1fr] lg:items-center lg:gap-8">
        <ul class="flex flex-col gap-4 sm:gap-6 lg:gap-14">
          {goals.slice(0, 3).map((goal, i) => <GoalCard index={i + 1} label={goal} />)}
        </ul>

        <img
          src="/icons/logo-mark.svg"
          alt=""
          width={220}
          height={120}
          class="col-span-full mx-auto hidden h-28 w-auto lg:col-span-1 lg:block"
        />

        <ul class="flex flex-col gap-4 sm:gap-6 lg:gap-14">
          {goals.slice(3).map((goal, i) => <GoalCard index={i + 4} label={goal} />)}
        </ul>
      </div>
    </div>
  </div>
</section>
