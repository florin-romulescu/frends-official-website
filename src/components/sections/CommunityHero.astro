---
import { getImage } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '../../i18n';
import heroPhoto from '../../assets/img/community-hero.jpg';
import Section from '../../layouts/primitives/Section.astro';
import Stack from '../../layouts/primitives/Stack.astro';
import PhotoCard from '../PhotoCard';
import PhotoCardSlot from '../PhotoCardSlot';
import Pill from '../Pill';
import StatusBadge from '../StatusBadge';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const optimized = await getImage({
  src: heroPhoto,
  widths: [480, 768, 1024, 1400],
  sizes: '(width >= 80rem) 57vw, 100vw',
});

const photo = {
  src: optimized.src,
  srcSet: optimized.srcSet.attribute || undefined,
  width: optimized.attributes.width,
  height: optimized.attributes.height,
};
---
<Section space="md">
  <div class="grid gap-8 xl:grid-cols-[4fr_3fr] xl:items-start xl:gap-14">
    <Stack gap="lg" align="start" class="order-first xl:order-none xl:items-end xl:pt-6 xl:text-right">
      <h1 class="max-w-[38rem] font-display text-display font-extrabold text-brand">
        {t('community.heading')}
      </h1>
      <StatusBadge status="open" label={t('events.status.open')} />
    </Stack>

    <PhotoCard
      image={photo}
      imageAlt={t('community.heroAlt')}
      shape="wide"
      priority
      className="xl:order-first"
    >
      <PhotoCardSlot corner="top-left">
        <Pill variant="headline">{t('community.heroPill')}</Pill>
      </PhotoCardSlot>
      <PhotoCardSlot corner="bottom-right">
        <Pill variant="caption">{t('community.heroCaption')}</Pill>
      </PhotoCardSlot>
    </PhotoCard>
  </div>
</Section>
