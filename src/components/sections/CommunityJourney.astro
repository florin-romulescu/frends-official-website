---
import { getLangFromUrl, useTranslations } from '../../i18n';
import { getSiteImage } from '../../data/images';
import Section from '../../layouts/primitives/Section.astro';
import Stack from '../../layouts/primitives/Stack.astro';
import PhotoCard from '../PhotoCard';
import PhotoCardSlot from '../PhotoCardSlot';
import Pill from '../Pill';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const [comedy, univibes] = await Promise.all([
  getSiteImage('community_comedy'),
  getSiteImage('community_univibes'),
]);
---
<Section space="md">
  <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-[409fr_500fr_483fr] xl:items-center xl:gap-10">
    <Stack gap="md" align="center" class="text-center sm:col-span-2 xl:order-2 xl:col-span-1">
      <Pill variant="headline">{t('community.journeyTitle')}</Pill>
      <p class="max-w-[29rem] text-body-lg">{t('community.journeyBody')}</p>
    </Stack>

    <PhotoCard image={comedy} imageAlt={comedy.alt} shape="square" className="xl:order-1 xl:self-end">
      <PhotoCardSlot corner="bottom-left">
        <Pill variant="caption">{t('community.comedyCaption')}</Pill>
      </PhotoCardSlot>
    </PhotoCard>

    <PhotoCard image={univibes} imageAlt={univibes.alt} shape="square" className="xl:order-3 xl:-mt-32 xl:self-start">
      <PhotoCardSlot corner="bottom-right">
        <Pill variant="caption">{t('community.univibesCaption')}</Pill>
      </PhotoCardSlot>
    </PhotoCard>
  </div>
</Section>
