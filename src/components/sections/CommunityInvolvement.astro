---
import { getLangFromUrl, useTranslations } from '../../i18n';
import { getSiteImage } from '../../data/images';
import RemoteImage from '../RemoteImage.astro';
import Section from '../../layouts/primitives/Section.astro';
import Stack from '../../layouts/primitives/Stack.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const background = await getSiteImage('community_band_background');
const reasons = [t('community.involve1'), t('community.involve2'), t('community.involve3')];
---
<Section space="md">
  <Stack gap="lg">
    <h2 class="text-h2 text-center xl:pr-16 xl:text-right">{t('community.involveTitle')}</h2>

    <div class="relative overflow-hidden rounded-panel bg-brand-light">
      <RemoteImage
        image={background}
        alt=""
        sizes="100vw"
        class="absolute inset-0 size-full object-cover opacity-20"
      />
      <ul class="relative grid gap-8 px-6 py-10 text-center text-body-lg md:grid-cols-3 lg:gap-14 lg:px-16 lg:py-14">
        {reasons.map((reason) => <li class="mx-auto max-w-[24rem]">{reason}</li>)}
      </ul>
    </div>
  </Stack>
</Section>
