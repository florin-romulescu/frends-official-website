---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations, localizePath, formatPeriod } from '../../i18n';
import type { EventStatus } from '../types';
import Section from '../../layouts/primitives/Section.astro';
import Stack from '../../layouts/primitives/Stack.astro';
import Carousel from '../Carousel.astro';
import CarouselSlide from '../CarouselSlide.astro';
import EventCard from '../EventCard';
import Pill from '../Pill';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const events = (await getCollection('events')).sort((a, b) =>
  b.data.startDate.localeCompare(a.data.startDate),
);

const statusLabels: Record<EventStatus, string> = {
  open: t('events.status.open'),
  ongoing: t('events.status.ongoing'),
  completed: t('events.status.completed'),
};
---
{
  events.length > 0 && (
    <Section id="evenimente" space="sm" band="warm" width="wide">
      <Stack gap="xl" align="center">
        <Pill variant="title">{t('events.title')}</Pill>

        <div class="w-full">
          <Carousel
            id="events"
            count={events.length}
            label={t('events.title')}
            slideLabel={(n: number) => `${t('events.title')} ${n}`}
          >
            {events.map((event, i) => (
              <CarouselSlide id="events" index={i + 1}>
                <EventCard
                  title={event.data.title}
                  period={formatPeriod(event.data.startDate, event.data.endDate, lang)}
                  description={event.data.description}
                  image={event.data.image}
                  imageAlt={event.data.imageAlt}
                  status={event.data.status}
                  statusLabel={statusLabels[event.data.status]}
                  href={localizePath(`/evenimente/${event.id}`, lang)}
                  readMoreLabel={t('events.readMore')}
                />
              </CarouselSlide>
            ))}
          </Carousel>
        </div>
      </Stack>
    </Section>
  )
}
