---
interface Props {
  id: string;
  index: number;
}

const { id, index }: Props = Astro.props;

const oneThirdOfTrack = 'xl:w-[calc((100%-3rem)/3)] xl:max-w-[27.5rem]';
---
<li
  id={`${id}-slide-${index}`}
  class:list={['flex scroll-mx-4 w-[85vw] max-w-[27.5rem] sm:w-[26rem]', oneThirdOfTrack]}
>
  <slot />
</li>
