---
interface Props {
  label: string;
  id: string;
  count: number;
  labels: {
    first: string;
    last: string;
    slide: (n: number) => string;
  };
}

const { label, id, count, labels }: Props = Astro.props;

const slideId = (n: number) => `${id}-slide-${n}`;

const arrowClass =
  'hidden size-14 shrink-0 place-items-center rounded-full bg-surface shadow-control transition-transform hover:scale-105 xl:grid xl:size-20';
---
<div class="relative">
  <div class="flex items-stretch gap-4">
    <a href={`#${slideId(1)}`} class={arrowClass}>
      <span class="sr-only">{labels.first}</span>
      <img src="/icons/arrow.png" alt="" width={32} height={32} class="size-8 rotate-180" />
    </a>

    <ul
      class="snap-track -mx-4 min-w-0 flex-1 gap-6 px-4 py-2 xl:mx-0 xl:px-0"
      tabindex="0"
      role="group"
      aria-label={label}
    >
      <slot />
    </ul>

    <a href={`#${slideId(count)}`} class={arrowClass}>
      <span class="sr-only">{labels.last}</span>
      <img src="/icons/arrow.png" alt="" width={32} height={32} class="size-8" />
    </a>
  </div>

  <ul class="mt-6 flex items-center justify-center gap-2">
    {
      Array.from({ length: count }, (_, i) => (
        <li>
          <a
            href={`#${slideId(i + 1)}`}
            class="block size-2.5 rounded-full bg-surface/70 transition-colors hover:bg-surface"
          >
            <span class="sr-only">{labels.slide(i + 1)}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>
