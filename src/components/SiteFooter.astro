---
import { getLangFromUrl, useTranslations, localizePath } from '../i18n';
import { site } from '../data/site';
import Footer from './Footer';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const items = site.footerNav.map((entry) => ({
  label: t(entry.key),
  href: localizePath(entry.path, lang),
}));
---

<footer class="mt-24 border-t border-border-default">
  <div class="container-content">
    <Footer
      tagline={t('footer.tagline')}
      email={site.email}
      phone={site.phone}
      addressLines={site.addressLines}
      items={items}
      social={site.social}
      labels={{
        brand: site.name,
        links: t('footer.links'),
        contact: t('footer.contact'),
        address: t('footer.address'),
        rights: t('footer.rights'),
      }}
      year={new Date().getFullYear()}
    />
  </div>
</footer>
