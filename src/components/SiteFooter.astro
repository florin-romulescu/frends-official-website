---
import { getLangFromUrl, useTranslations, localizePath } from '../i18n';
import { site } from '../data/site';
import Footer from './Footer';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const items = site.nav.map((entry) => ({
  label: t(entry.key),
  href: localizePath(entry.path, lang),
}));
---

<footer class="mt-24 border-t border-ink-500/10 bg-brand-50/40">
  <div class="container-content">
    <Footer
      siteName={site.name}
      email={site.email}
      items={items}
      social={site.social}
      labels={{ nav: t('footer.nav'), followUs: t('footer.followUs'), rights: t('footer.rights') }}
      year={new Date().getFullYear()}
    />
  </div>
</footer>
