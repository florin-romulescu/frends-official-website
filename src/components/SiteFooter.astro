---
import { getLangFromUrl, useTranslations, localizePath, localizeHref } from '../i18n';
import { getSite } from '../data/site';
import { getSiteImage } from '../data/images';
import { socialIcons } from '../data/social';
import Footer from './Footer';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const site = await getSite();
const [logo, icons] = await Promise.all([getSiteImage('logo_footer'), socialIcons()]);

const items = [
  ...site.footerNav.map((entry) => ({ label: t(entry.key), href: localizePath(entry.path, lang) })),
  { label: t('nav.volunteer'), href: localizeHref(site.volunteerUrl, lang) },
];
---
<footer class="mt-24 border-t border-border-default">
  <div class="container-content">
    <Footer
      tagline={t('footer.tagline')}
      email={site.email}
      phone={site.phone}
      addressLines={site.addressLines}
      items={items}
      social={site.social}
      logo={logo.src}
      socialIcons={icons}
      labels={{
        brand: site.name,
        links: t('footer.links'),
        contact: t('footer.contact'),
        address: t('footer.address'),
        rights: t('footer.rights'),
      }}
      year={new Date().getFullYear()}
    />
  </div>
</footer>
