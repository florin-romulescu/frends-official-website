---
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations, localizePath, localizeHref, isExternal } from '../i18n';
import { getSite, type NavEntry } from '../data/site';
import sky from '../assets/img/sky.jpg';
import type { NavItem } from './types';
import Brand from './Brand';
import Nav from './Nav';
import Button from './Button';
import MobileNav from './MobileNav';
import SocialLinks from './SocialLinks';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const site = await getSite();
const currentPath = Astro.url.pathname.replace(/(.)\/$/, '$1');

const toNavItem = (entry: NavEntry): NavItem => {
  const href = localizePath(entry.path, lang);
  const children = entry.children?.map(toNavItem);
  const current = href === currentPath;
  return {
    label: t(entry.key),
    href,
    current,
    active: current || (children?.some((child) => child.active) ?? false),
    children,
  };
};

const items = site.nav.map(toNavItem);

const cta = { label: t('nav.volunteer'), href: localizeHref(site.volunteerUrl, lang) };
---
<header class="relative overflow-hidden bg-linear-to-b from-[#21b4ec] to-brand-light">
  <Image
    src={sky}
    alt=""
    widths={[768, 1280, 1728]}
    sizes="100vw"
    class="absolute inset-0 size-full object-cover opacity-15"
    loading="eager"
  />
  <div class="container-content relative flex h-24 items-center justify-between lg:h-31">
    <Brand href={localizePath('/', lang)} name={site.name} />
    <SocialLinks links={site.social} className="[&_img]:brightness-0 [&_img]:invert" />
  </div>
</header>

<nav
  aria-label={t('nav.primary')}
  class="sticky top-3 z-40 container-content -mt-8 lg:top-4 lg:-mt-9"
>
 <div
    class="ml-auto flex h-16 w-fit items-center justify-between gap-2 rounded-nav bg-surface px-3 shadow-nav lg:ml-0 lg:h-17 lg:w-full lg:gap-4 lg:pr-2.5 lg:pl-3.5"
  >
    <Nav items={items} />

    <div class="flex items-center gap-2 lg:flex-1 lg:justify-end">
      <Button href={cta.href} external={isExternal(cta.href)}>{cta.label}</Button>
      <MobileNav items={items} openLabel={t('nav.menu')} />
    </div>
  </div>
</nav>
