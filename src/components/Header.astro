---
/**
 * Thin composition shell. All visual pieces are React components; this file
 * exists only to resolve the locale-dependent props they need.
 *
 * Nothing in the header is hydrated — see MobileNav for why.
 */
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n';
import { site } from '../data/site';
import sky from '../assets/img/sky.jpg';
import Brand from './Brand';
import Nav from './Nav';
import Button from './Button';
import MobileNav from './MobileNav';
import SocialLinks from './SocialLinks';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const currentPath = Astro.url.pathname.replace(/(.)\/$/, '$1');

const items = site.nav.map((entry) => {
  const href = localizePath(entry.path, lang);
  return { label: t(entry.key), href, current: href === currentPath };
});

const cta = { label: t('nav.volunteer'), href: localizePath(site.volunteerUrl, lang) };
---

<header class="relative">
  {/* Sky band. The nav pill below overlaps its lower edge, as in the design. */}
  <div class="relative overflow-hidden bg-linear-to-b from-[#21b4ec] to-brand-light">
    <Image
      src={sky}
      alt=""
      widths={[768, 1280, 1728]}
      sizes="100vw"
      class="absolute inset-0 size-full object-cover opacity-15"
      loading="eager"
    />
    <div class="container-content relative flex h-24 items-center justify-between lg:h-31">
      <Brand href={localizePath('/', lang)} name={site.name} />
      <SocialLinks links={site.social} className="[&_img]:brightness-0 [&_img]:invert" />
    </div>
  </div>

  <div class="container-content relative -mt-8 lg:-mt-9">
    <div
      class="flex h-16 items-center justify-between gap-4 rounded-nav bg-surface px-3 shadow-nav lg:h-17 lg:pr-2.5 lg:pl-3.5"
    >
      <Nav items={items} />

      <div class="flex flex-1 items-center justify-end gap-2">
        <Button href={cta.href}>{cta.label}</Button>
        <MobileNav items={items} cta={cta} openLabel={t('nav.menu')} />
      </div>
    </div>
  </div>
</header>
