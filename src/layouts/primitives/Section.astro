---
import Container from './Container.astro';

interface Props {
  space?: 'none' | 'sm' | 'md' | 'lg';
  band?: 'none' | 'warm' | 'sky' | 'subtle';
  width?: 'prose' | 'content' | 'wide' | 'full';
  bandPadding?: 'md' | 'lg';
  id?: string;
  class?: string;
}

const {
  space = 'md',
  band = 'none',
  width = 'content',
  bandPadding = 'lg',
  id,
  class: className = '',
}: Props = Astro.props;

const spaces = {
  none: '',
  sm: 'section-space-sm',
  md: 'section-space-md',
  lg: 'section-space-lg',
} as const;

const bands = {
  none: '',
  warm: 'bg-accent-warm',
  sky: 'bg-brand-light',
  subtle: 'bg-surface-subtle',
} as const;

const bandPaddings = {
  md: 'px-4 py-8 sm:px-6 lg:px-10 lg:py-12',
  lg: 'px-4 py-12 sm:px-6 lg:px-10 lg:py-14',
} as const;

const hasBand = band !== 'none';
---
<section id={id} class:list={[spaces[space], className]}>
  <Container width={width}>
    {
      hasBand ? (
        <div class:list={['relative overflow-hidden rounded-panel', bands[band]]}>
          <slot name="background" />
          <div class:list={['relative', bandPaddings[bandPadding]]}>
            <slot />
          </div>
        </div>
      ) : (
        <slot />
      )
    }
  </Container>
</section>
