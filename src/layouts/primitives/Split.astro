---
interface Props {
  at?: 'md' | 'lg' | 'xl';
  ratio?: '1:1' | '1:2' | '2:1';
  gap?: 'md' | 'lg' | 'xl';
  align?: 'start' | 'center' | 'stretch';
  reverse?: boolean;
  class?: string;
}

const {
  at = 'xl',
  ratio = '1:1',
  gap = 'lg',
  align = 'center',
  reverse = false,
  class: className = '',
}: Props = Astro.props;

const columns = {
  'md-1:1': 'md:grid-cols-2',
  'md-1:2': 'md:grid-cols-[1fr_2fr]',
  'md-2:1': 'md:grid-cols-[2fr_1fr]',
  'lg-1:1': 'lg:grid-cols-2',
  'lg-1:2': 'lg:grid-cols-[1fr_2fr]',
  'lg-2:1': 'lg:grid-cols-[2fr_1fr]',
  'xl-1:1': 'xl:grid-cols-2',
  'xl-1:2': 'xl:grid-cols-[1fr_2fr]',
  'xl-2:1': 'xl:grid-cols-[2fr_1fr]',
} as const;

const reverses = {
  md: '[&>*:first-child]:md:order-2',
  lg: '[&>*:first-child]:lg:order-2',
  xl: '[&>*:first-child]:xl:order-2',
} as const;

const gaps = { md: 'gap-8', lg: 'gap-10 xl:gap-14', xl: 'gap-12 xl:gap-20' } as const;
const aligns = { start: 'items-start', center: 'items-center', stretch: 'items-stretch' } as const;
---
<div
  class:list={[
    'grid',
    columns[`${at}-${ratio}`],
    gaps[gap],
    aligns[align],
    reverse && reverses[at],
    className,
  ]}
>
  <slot />
</div>
