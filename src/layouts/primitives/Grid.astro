---
interface Props {
  min?: '8rem' | '12rem' | '16rem' | '20rem' | '24rem' | '28rem';
  gap?: 'sm' | 'md' | 'lg';
  as?: 'div' | 'ul' | 'ol';
  class?: string;
}

const { min = '16rem', gap = 'md', as: Tag = 'div', class: className = '' }: Props = Astro.props;

const mins = {
  '8rem': 'grid-cols-[repeat(auto-fit,minmax(min(8rem,100%),1fr))]',
  '12rem': 'grid-cols-[repeat(auto-fit,minmax(min(12rem,100%),1fr))]',
  '16rem': 'grid-cols-[repeat(auto-fit,minmax(min(16rem,100%),1fr))]',
  '20rem': 'grid-cols-[repeat(auto-fit,minmax(min(20rem,100%),1fr))]',
  '24rem': 'grid-cols-[repeat(auto-fit,minmax(min(24rem,100%),1fr))]',
  '28rem': 'grid-cols-[repeat(auto-fit,minmax(min(28rem,100%),1fr))]',
} as const;

const gaps = { sm: 'gap-4', md: 'gap-6', lg: 'gap-6 lg:gap-8' } as const;
---
<Tag class:list={['grid', mins[min], gaps[gap], className]}><slot /></Tag>
