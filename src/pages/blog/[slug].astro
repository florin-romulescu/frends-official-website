---
import { getCollection } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { getLangFromUrl, useTranslations, localizePath, formatDate } from '../../i18n';

export const getStaticPaths = async () =>
  (await getCollection('blog')).map((post) => ({ params: { slug: post.id }, props: { post } }));

const { post } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<Article
  title={post.data.title}
  description={post.data.excerpt}
  image={post.data.image}
  imageAlt={post.data.imageAlt}
  body={post.data.body}
  back={{ label: t('blog.back'), href: localizePath('/blog', lang) }}
>
  <time slot="meta" datetime={post.data.date} class="text-body text-ink-muted">
    {formatDate(post.data.date, lang)}
  </time>
</Article>
