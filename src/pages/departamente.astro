---
import Base from '../layouts/Base.astro';
import { getLangFromUrl, useTranslations } from '../i18n';
import Section from '../layouts/primitives/Section.astro';
import Stack from '../layouts/primitives/Stack.astro';
import Cluster from '../layouts/primitives/Cluster.astro';
import Departments from '../components/sections/Departments.astro';
import DepartmentTile from '../components/DepartmentTile';
import Pill from '../components/Pill';
import { departments } from '../data/departments';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const stats = [
  t('departments.statDepartments'),
  t('departments.statSubdivisions'),
  t('departments.statVolunteers'),
];

const orbs = [
  'top-4 right-[6%] size-40',
  'top-32 right-[22%] size-24',
  'top-2 right-[34%] size-16',
  'top-40 right-[2%] size-20',
  'top-20 right-[14%] size-12',
];
---
<Base title={t('departments.title')} description={t('departments.description')}>
  <Section space="md" class="overflow-x-clip">
    <div class="relative">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 hidden lg:block">
        {
          departments.map((department, i) => (
            <span
              class:list={['absolute rounded-full opacity-35 blur-xl motion-safe:animate-float', orbs[i]]}
              style={`background:var(--color-dept-${department.accent});animation-duration:${8 + i * 1.5}s;animation-delay:-${i * 2}s`}
            />
          ))
        }
      </div>

      <Stack gap="lg" class="relative">
        <h1 class="enter font-display text-display font-extrabold text-brand">
          {t('departments.heading')}
        </h1>
        <p class="enter max-w-[47.5rem] text-body-lg text-ink-secondary" style="--enter-delay:120ms">
          {t('departments.lede')}
        </p>
        <Cluster gap="sm" as="ul" class="enter [--enter-delay:240ms]">
          {stats.map((stat) => <li><Pill variant="gray">{stat}</Pill></li>)}
        </Cluster>

        <nav aria-label={t('departments.overview')} class="enter [--enter-delay:360ms]">
          <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
            {
              departments.map((department, i) => (
                <li>
                  <DepartmentTile
                    href={`#${department.id}`}
                    number={String(i + 1).padStart(2, '0')}
                    name={department.name}
                    meta={`${department.subdivisions.length} ${t('departments.subdivisions')}`}
                    accent={department.accent}
                  />
                </li>
              ))
            }
          </ul>
        </nav>
      </Stack>
    </div>
  </Section>

  <Departments />
</Base>
