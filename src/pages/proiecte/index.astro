---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../layouts/primitives/Section.astro';
import Stack from '../../layouts/primitives/Stack.astro';
import Grid from '../../layouts/primitives/Grid.astro';
import ArticleCard from '../../components/ArticleCard';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const projects = (await getCollection('projects')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    (b.data.year ?? 0) - (a.data.year ?? 0) ||
    b.data.date.localeCompare(a.data.date),
);
---
<Base title={t('projects.title')} description={t('projects.description')}>
  <Section space="md">
    <Stack gap="xl">
      <Stack gap="lg">
        <h1 class="font-display text-display font-extrabold text-brand">{t('projects.heading')}</h1>
        <p class="max-w-[47.5rem] text-body-lg text-ink-secondary">{t('projects.lede')}</p>
      </Stack>

      {
        projects.length > 0 ? (
          <Grid as="ul" min="20rem" gap="lg">
            {projects.map((project) => (
              <li>
                <ArticleCard
                  title={project.data.title}
                  description={project.data.summary}
                  image={project.data.image}
                  imageAlt={project.data.imageAlt}
                  href={localizePath(`/proiecte/${project.id}`, lang)}
                  readMoreLabel={t('common.readMore')}
                  tags={[
                    ...(project.data.year ? [String(project.data.year)] : []),
                    ...(project.data.featured ? [t('projects.featured')] : []),
                  ]}
                />
              </li>
            ))}
          </Grid>
        ) : (
          <p class="text-body-lg text-ink-muted">{t('projects.empty')}</p>
        )
      }
    </Stack>
  </Section>
</Base>
