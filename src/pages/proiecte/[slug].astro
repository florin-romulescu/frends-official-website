---
import { revealDelay } from '../../lib/motion';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../layouts/primitives/Section.astro';
import Split from '../../layouts/primitives/Split.astro';
import Stack from '../../layouts/primitives/Stack.astro';
import Cluster from '../../layouts/primitives/Cluster.astro';
import Grid from '../../layouts/primitives/Grid.astro';
import Button from '../../components/Button';
import Pill from '../../components/Pill';
import PhotoCard from '../../components/PhotoCard';
import PhotoCardSlot from '../../components/PhotoCardSlot';
import BlockContent from '../../components/BlockContent.astro';
import StatusBadge from '../../components/StatusBadge';
import { getSiteImage } from '../../data/images';
import {
  getLangFromUrl,
  useTranslations,
  localizePath,
  formatPeriod,
} from '../../i18n';

export const getStaticPaths = async () =>
  (await getCollection('projects')).map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));

const { project } = Astro.props;
const { data } = project;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const highlightIcon = await getSiteImage('icon_help');

const statusLabels = {
  open: t('projects.status.open'),
  ongoing: t('projects.status.ongoing'),
  completed: t('projects.status.completed'),
};

const period = data.startDate && formatPeriod(data.startDate, data.endDate, lang);

const meta = [period, data.location]
  .filter(Boolean)
  .join('  ·  ');
---
<Base title={data.title} description={data.summary} image={data.image}>
  <div style={`--accent:${data.accentColor ?? 'var(--color-brand)'}`}>
    <Section space="md">
      <Split at="xl" gap="xl">
        <Stack gap="lg">
          <Cluster gap="sm" class="enter">
            {data.status && (
              <StatusBadge status={data.status} label={statusLabels[data.status]} className="-ml-4" />
            )}
            {data.category && <Pill variant="caption">{data.category}</Pill>}
          </Cluster>

          <Stack gap="sm" class="enter [--enter-delay:120ms]">
            <h1 class="font-display text-display font-extrabold text-(--accent)">{data.title}</h1>
            {meta && <p class="text-body-lg font-black text-ink-muted">{meta}</p>}
          </Stack>

          <p class="enter max-w-[39rem] text-body-lg [--enter-delay:240ms]">{data.summary}</p>

          <Cluster gap="md" class="enter [--enter-delay:360ms]">
            <Button href={localizePath('/proiecte', lang)} variant="secondary" tone="accent">
              {t('projects.viewAll')}
            </Button>
          </Cluster>
        </Stack>

        <PhotoCard image={data.image} imageAlt={data.imageAlt} shape="landscape" priority>
          {
            data.highlight && (
              <PhotoCardSlot corner="bottom-right">
                <p class="flex max-w-[300px] items-center gap-3 rounded-card bg-surface p-4 text-body-lg font-black shadow-card motion-safe:animate-float xl:gap-4 xl:p-6">
                  <img src={highlightIcon.src} alt="" width={36} height={36} class="size-9 shrink-0" />
                  <span>{data.highlight}</span>
                </p>
              </PhotoCardSlot>
            )
          }
        </PhotoCard>
      </Split>
    </Section>

    <Section space="md">
      <Stack gap="lg">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between lg:gap-8">
          <h2 class="reveal shrink-0 text-h2 text-(--accent)">{t('projects.about')}</h2>
          {
            data.facts.length > 0 && (
              <ul class="-mx-4 flex min-w-0 gap-3 overflow-x-auto px-4 py-1 [scrollbar-width:none] lg:mx-0 lg:justify-end lg:px-0 [&::-webkit-scrollbar]:hidden">
                {data.facts.map((fact) => (
                  <li class="shrink-0 transition-transform duration-300 hover:-translate-y-0.5">
                    <Pill variant="label">{fact}</Pill>
                  </li>
                ))}
              </ul>
            )
          }
        </div>

        <BlockContent html={project.body ?? ''} class="reveal prose-a:text-(--accent)" />
      </Stack>
    </Section>

    {
      data.impact.length > 0 && (
        <Section space="lg">
          <Stack gap="xl">
            <Stack gap="md" align="center" class="reveal text-center">
              <h2 class="text-h2 text-(--accent)">{t('projects.impact')}</h2>
              {data.impactLede && <p class="text-body-lg text-ink-muted">{data.impactLede}</p>}
            </Stack>

            <Grid as="ul" min="20rem" gap="lg">
              {data.impact.map((card, i) => (
                <li class="reveal" style={revealDelay(i)}>
                  <PhotoCard image={card.photo} imageAlt={card.photoAlt} zoom>
                    {(card.stat || card.label) && (
                      <PhotoCardSlot corner="top-left">
                        {card.stat && <Pill variant="stat">{card.stat}</Pill>}
                        {card.label && <Pill variant="stat">{card.label}</Pill>}
                      </PhotoCardSlot>
                    )}
                  </PhotoCard>
                </li>
              ))}
            </Grid>
          </Stack>
        </Section>
      )
    }
  </div>
</Base>
