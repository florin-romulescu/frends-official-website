---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Events from '../components/sections/Events.astro';
import About from '../components/sections/About.astro';
import Goals from '../components/sections/Goals.astro';
import Impact from '../components/sections/Impact.astro';
import Partners from '../components/sections/Partners.astro';
import { useTranslations } from '../i18n';

const lang = 'ro' as const;
const t = useTranslations(lang);
---
<Base title={t('home.title')} description={t('home.description')}>
  <Hero />
  <Events />
  <About />
  <Goals />
  <Impact />
  <Partners />
</Base>
